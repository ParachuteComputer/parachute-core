# Started by parachute-probe.service's OnFailure= when a probe fails (docs/probe/README.md).
# This example only writes the failing line to the journal under its own tag. Replace ExecStart with your own
# alert (a mail, a chat webhook, a push), and keep the pass and note content out of it: the probe's line has neither.
# _SYSTEMD_USER_UNIT= matches only the probe's own output; `-u` would also match systemd's "Failed to start" line,
# which comes last.
[Unit]
Description=Parachute probe failed: tell someone

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'journalctl --user _SYSTEMD_USER_UNIT=parachute-probe.service -n 1 -o cat --no-pager | systemd-cat -t parachute-probe-alert -p err'
