# Parachute Vault — Configuration
# Copy to .env and fill in your values.

# Server
PORT=1940

# PARACHUTE_VAULT_NAME=myvault  # set to auto-create a first vault on first boot; omit to start empty
# VAULT_AUTH_TOKEN=            # the operator bearer for a vault without a hub; first boot makes no API key (0.9.1)

# Domain for HTTPS (required for MCP from Claude Desktop)
# Leave empty for local-only / development use.
# VAULT_DOMAIN=vault.yourdomain.com
