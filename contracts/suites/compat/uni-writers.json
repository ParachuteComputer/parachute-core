            "vault",
            "aggregate{op:count}",
            "limit",
            "offset",
            "id",
            "include_content",
            "path",
            "exclude_tags",
            "exclude_path_prefix"
          ]
        },
        {
          "mcp": "doctor",
          "args": [
            "vault"
          ]
        },
        {
          "mcp": "update-note",
          "args": [
            "vault",
            "id",
            "tags{add|remove}",
            "content",
            "metadata",
            "append",
            "if_updated_at",
            "include_content:false"
          ]
        },
        {
          "mcp": "create-note",
          "args": [
            "vault",
            "path",
            "content",
            "tags:[system]",
            "metadata"
          ]
        }
      ],
      "reads": [
        "{results:[{vault, notes|result|note|data|error}]}",
        "updatedAt",
        "id"
      ],
      "probe": "uni-nightly"
    },
