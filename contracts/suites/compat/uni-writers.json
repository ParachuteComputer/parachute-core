    {
      "name": "fireflies-ingest",
      "extra": "found by grep; not in PLAN §8.1",
      "transport": "rest",
      "base": "vault-direct (PARACHUTE_VAULT_BASE)",
      "auth": {
        "kind": "bearer-script-pass",
        "token_from": "PARACHUTE_TOKENS_FILE entry parachute-uni"
      },
      "calls": [
        {
          "method": "GET",
          "path": "/notes",
